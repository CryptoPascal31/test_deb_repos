[Unit]
Description=Kadena Mining Client

[Service]
User=mining
KillMode=process
KillSignal=SIGINT

WorkingDirectory=/var/lib/chainweb-mining-client
ExecStart=chainweb-mining-client --config-file=/etc/chainweb-mining-client/config.taml
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
